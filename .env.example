DATABASE_URL=postgres://jeenee:jeenee@127.0.0.1:5432/jeenee

ANTHROPIC_API_KEY=

# API 키가 없을 때 샘플 스토리로 동작한다. 로컬 개발 전용이며 운영 환경에는 넣지 않는다.
JEENEE_MOCK_AI=1

# 모델 교체용 (기본값 사용 시 생략 가능)
# JEENEE_STORY_MODEL=claude-opus-5-5
# JEENEE_ANALYSIS_MODEL=claude-haiku-5-5

# /admin 접속 비밀값. 비워두면 관리자 페이지가 비활성화된다.
ADMIN_SECRET=

# 실제 소원 호출의 하루 지출 상한 (USD)
DAILY_SPEND_LIMIT_USD=20

# 앱이 Caddy 뒤에서만 접근 가능할 때만 1로 설정한다.
TRUST_PROXY=0

# Google Analytics 측정 ID (선택)
NEXT_PUBLIC_GA_ID=
