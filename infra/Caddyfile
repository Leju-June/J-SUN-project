# 운영용. 서비스마다 컨테이너를 따로 두고 경로로 나눈다.
{$DOMAIN} {
	@jeenee path /jeenee /jeenee/*
	handle @jeenee {
		reverse_proxy jeenee:3000 {
			header_up X-Real-IP {remote_host}
			# 스토리 스트리밍이 버퍼에 묶이지 않게 바로 내보낸다.
			flush_interval -1
		}
	}
	handle {
		reverse_proxy gateway:3000 {
			header_up X-Real-IP {remote_host}
		}
	}
}
