# 개발용. 호스트에서 돌고 있는 gateway(3000), jeenee(3001), j-son(3002)를 8080 하나로 묶는다.
:8080 {
	@jeenee path /jeenee /jeenee/*
	handle @jeenee {
		reverse_proxy host.docker.internal:3001 {
			# 스토리 스트리밍이 버퍼에 묶이지 않게 바로 내보낸다.
			flush_interval -1
		}
	}
	@json path /j-son /j-son/*
	handle @json {
		reverse_proxy host.docker.internal:3002
	}
	handle {
		reverse_proxy host.docker.internal:3000
	}
}
